# Copy to .env and adjust as needed. All defaults work for local dev
# when commands are run from the repo root.

# --- Backend (DRISHTI_ prefix) ---
DRISHTI_HOST=0.0.0.0
DRISHTI_PORT=8000
DRISHTI_DB_PATH=./data/drishti.db
DRISHTI_TOPOLOGY_PATH=./data/topology.json

# --- Simulator (SIM_ prefix) ---
SIM_BACKEND_URL=http://localhost:8000
SIM_TOPOLOGY_PATH=./data/topology.json
SIM_INTERVAL_SECONDS=5
SIM_API_PORT=8100
SIM_SEED=42
